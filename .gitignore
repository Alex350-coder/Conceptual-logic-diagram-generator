# Ignore everything
*

# Allow Project folder
!Project/
!Project/**

# Allow CI workflow (GitHub Actions requires repo-root location)
!.github/
!.github/**

# Playwright artifacts
Project/client/test-results/

# Allow planning docs (P11+: re-track, restores audit trail)
!PlanningFiles/
!PlanningFiles/**

# Allow OpenAI config
!opencode.json

# Allow own gitignore + config
!.gitignore
