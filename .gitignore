# Ignore everything
*

# Allow Project folder
!Project/
!Project/**

# Allow CI workflow (GitHub Actions requires repo-root location)
!.github/
!.github/**

# Playwright artifacts
Project/client/test-results/
Project/client/playwright-report/

# SQLite runtime data (default DB_PATH: server/data/erd-studio.db)
Project/server/data/

# Developer-local tooling (fuera del repositorio):
# - PlanningFiles/ (planificacion y sistema de skills/reglas)
# - opencode.json (config local del agente)
# Ambos quedan cubiertos por el ignore-all de arriba (no se whitelistean).

# Allow root README (repo landing on GitHub)
!README.md

# Allow own gitignore + config
!.gitignore
