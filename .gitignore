# Ignore everything
*

# Allow Project folder
!Project/
!Project/**

# Allow CI workflow (GitHub Actions requires repo-root location)
!.github/
!.github/**

# Playwright artifacts
Project/client/test-results/
Project/client/playwright-report/

# SQLite runtime data (default DB_PATH: server/data/erd-studio.db)
Project/server/data/

# Allow planning docs (P11+: re-track, restores audit trail)
!PlanningFiles/
!PlanningFiles/**

# Allow OpenAI config
!opencode.json

# Allow root README (repo landing on GitHub)
!README.md

# Allow own gitignore + config
!.gitignore
